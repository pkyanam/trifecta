{
  "expo": {
    "name": "Trifecta",
    "slug": "trifecta-mobile",
    "version": "1.3.0",
    "orientation": "portrait",
    "scheme": "trifecta",
    "userInterfaceStyle": "automatic",
    "owner": "belweave",
    "icon": "./assets/images/icon.png",
    "ios": {
      "bundleIdentifier": "com.belweave.trifecta",
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": false,
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "googleSignIn": {
          "reservedClientId": ""
        }
      }
    },
    "android": {
      "package": "com.belweave.trifecta",
      "usesCleartextTraffic": true,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#000000"
      }
    },
    "web": {
      "output": "server",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "expo-system-ui",
      "expo-status-bar",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      " eas": {
        "projectId": "your-project-id-here"
      },
      "router": {},
      "eas": {
        "projectId": "8894772a-12f7-4b08-9483-e7822b22ac1c"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/your-project-id-here"
    },
    "privacy": "https://trifecta.belweave.ai/privacy",
    "terms": "https://trifecta.belweave.ai/terms-and-conditions"
  }
}
