# =============================================================================
# Trifecta — Environment Variables
# Copy to .env.local and fill in values
# =============================================================================

# ── Daytona ──────────────────────────────────────────────────────────────────
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api

# ── Clerk Auth ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # optional, enables full server access

# ── Stripe Billing ───────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=

# ── Trifecta Config ──────────────────────────────────────────────────────────
TRIFECTA_SNAPSHOT_NAME=trifecta-server-v1
# GPU-enabled snapshot (required to provision GPU sandboxes; leave blank if not available)
TRIFECTA_GPU_SNAPSHOT_NAME=
TRIFECTA_NPM_VERSION=0.0.35-alpha.1
TRIFECTA_SERVER_PORT=3773
TRIFECTA_VOLUME_NAME=trifecta-persistent-data

# ── App URLs ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_TRIFECTA_WWW_URL=http://localhost:3000
NEXT_PUBLIC_TRIFECTA_APP_URL=https://app.trifecta.belweave.com

# ── Cloudflare CORS Proxy ─────────────────────────────────────────────────────
# Wildcard Worker domain that proxies Daytona traffic and adds CORS headers.
# Leave blank to use raw Daytona URLs (browser clients won't work without this).
NEXT_PUBLIC_CF_PROXY_DOMAIN=sbx.belweave.com

# ── Cron ──────────────────────────────────────────────────────────────────────
# Set in Vercel project settings so cron caller is verified. Optional but recommended.
CRON_SECRET=

# ── Triad gateway ─────────────────────────────────────────────────────────────
TRIAD_GATEWAY_URL=
INTERNAL_API_TOKEN=
NEXT_PUBLIC_TRIAD_API_BASE=

# ── Poke (preetham.org contact form relay) ────────────────────────────────────
# Powers /api/contact: forwards contact-form submissions to Poke (iMessage).
# Key from https://poke.com/settings/advanced — server-side only, never exposed.
POKE_API_KEY=
# Origins allowed to POST the contact form (comma-separated). Defaults to preetham.org.
CONTACT_ALLOWED_ORIGINS=https://preetham.org,https://www.preetham.org
